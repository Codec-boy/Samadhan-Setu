# Django Production Security Configuration Template
# Copy this file to .env and set real environment variables for deployment.

# Django Secret Key (Generate a random 50+ character string for production)
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# Debug Mode (Set to False in production)
DJANGO_DEBUG=True

# Allowed Hosts (Comma-separated hostnames/IPs)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# CORS Configuration
DJANGO_CORS_ALLOW_ALL=False
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Cookie Security (Set to True if serving over HTTPS)
DJANGO_SECURE_COOKIES=False

# CSRF Trusted Origins
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
